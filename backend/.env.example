# Database (use Neon PgBouncer pooled URL for high-concurrency production: *-pooler.c-11.us-east-1.aws.neon.tech)
DATABASE_URL=postgresql+asyncpg://neondb_owner:pass@ep-xxxx-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash)
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# ── Testing Mode ────────────────────────────────────────────────────
# Set these to test without OAuth. Use POST /api/v1/auth/setup-test
# to seed your user directly.
META_ACCESS_TOKEN=your_meta_business_api_access_token
META_INSTAGRAM_USER_ID=your_instagram_business_account_id

# ── Meta OAuth (disabled for testing, enable for production) ────────
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# META_VERIFY_TOKEN=your_custom_webhook_verify_token
# META_REDIRECT_URI=https://your-domain.com/api/v1/auth/callback

# Groq (fast text LLM for comment replies)
GROQ_API_KEY=gsk_your_groq_api_key

# Gemini (Video understanding & Audio)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# Tavily (Web Search)
TAVILY_API_KEY=tvly_your_tavily_key

# Security
ENCRYPTION_KEY=your_fernet_encryption_key
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# App
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
